# Dependencies
node_modules/
claudeOne/server/node_modules/

# Runtime files
*.log
output/
.playwright-cli/
claudeOne/.playwright-cli/
claudeOne/server/uploads/*
!claudeOne/server/uploads/.gitkeep
claudeOne/server/.music-key-cache/
claudeOne/server/data/*
!claudeOne/server/data/.gitkeep

# Browser/automation user-data dirs from local debugging
# (Chrome --user-data-dir, puppeteer/playwright temp profiles, etc.)
.chrome-diag-*/
.chrome-profile/
.puppeteer-cache/

# User-provided media. Keep the generated playlist artifact tracked.
claudeOne/music/*
!claudeOne/music/.gitkeep
!claudeOne/music/playlist.js
